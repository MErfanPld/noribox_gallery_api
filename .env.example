# --- Django ---------------------------------------------------------------
# manage.py uses config.settings.dev; wsgi/asgi use config.settings.prod.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tehran
LOG_LEVEL=INFO

# --- Database (PostgreSQL; set DB_ENGINE=sqlite for quick local hacking) ---
DB_ENGINE=postgresql
POSTGRES_DB=noribox
POSTGRES_USER=noribox
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Files -----------------------------------------------------------------
STATIC_ROOT=./staticfiles
MEDIA_ROOT=./media
# Payment receipts. Must NOT be exposed by the web server.
PRIVATE_MEDIA_ROOT=./private_media
RECEIPT_MAX_SIZE_BYTES=5242880
RECEIPT_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf
PRODUCT_IMAGE_MAX_SIZE_BYTES=8388608

# --- CORS / CSRF -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Production security (prod settings) -------------------------------------
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=false

# --- JWT ---------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# --- Throttling (DRF rate strings) -------------------------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_OTP_REQUEST=5/min
THROTTLE_OTP_VERIFY=10/min
THROTTLE_RECEIPT_UPLOAD=10/hour

# --- OTP ---------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_LOGIN_AUTO_REGISTER=true

# --- Inventory / orders ------------------------------------------------------
RESERVATION_TTL_HOURS=72
UNPAID_ORDER_TTL_HOURS=48
ORDER_MAX_ITEMS=50

# --- SMS ---------------------------------------------------------------------
SMS_ENABLED=false
# console | kavenegar | dotted.path.to.ProviderClass
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=
SMS_MAX_ATTEMPTS=3
SMS_RETRY_BASE_SECONDS=60
SMS_TIMEOUT_SECONDS=10
# Comma-separated admin phones notified on receipt upload (also configurable in store settings)
SMS_ADMIN_PHONES=

# --- Source import -----------------------------------------------------------
SOURCE_SITE_ID=mehrdadgallery
SOURCE_BASE_URL=https://mehrdadgallery.com
IMPORT_DEFAULT_LIMIT=0
IMPORT_REQUEST_TIMEOUT=15
IMPORT_MAX_PAGES=50
